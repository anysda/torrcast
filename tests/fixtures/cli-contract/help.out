usage: cast [-h] [--tv [IP]] [-tg] [--release N] [--pick N] [--menu]
            [--file N] [--voice [N|СТУДИЯ]] [--new] [--dry] [--since СРОК]
            [--version]
            [query ...]

torrcast - найти релиз и кастить его на ТВ без скачивания

positional arguments:
  query               название, либо stop / status

options:
  -h, --help          show this help message and exit
  --tv [IP]           настройка ТВ: без адреса - найти приёмники в сети и
                      выбрать из списка
  -tg                 открыть меню настройки Telegram-бота
  --release N         отладка: релиз N выбранной картины; номера - из cast
                      releases с тем же запросом
  --pick N            картина N из меню, без вопроса
  --menu              показать список картин и спросить, а не включать самому
  --file N            отладка: взять файл N раздачи
  --voice [N|СТУДИЯ]  озвучка: номер или студия - взять и запомнить, без
                      значения - меню
  --new               та же раздача, файл и дорожка с начала
  --dry               весь резолв без каста
  --since СРОК        cast log: с какого момента (2d / 12h / 30m / ГГГГ-ММ-ДД)
  --version           show program's version number and exit
