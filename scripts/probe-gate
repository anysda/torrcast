#!/bin/sh
set -eu

# Сторожа прибора веб-приёмки (tests/test_web_acceptance.py, машинный набор) не бегают
# в scripts/test-gate: playwright и Chromium намеренно не входят в венв гейта (см.
# pyproject.toml), а тащить их туда - лишний вес под потолком 6G ради того, что уже
# есть готовым на отдельной машине. Эта команда гоняет ровно те же два теста РЕАЛЬНЫМ
# Chromium на машине с установленным playwright и браузером (тот же принцип, что у
# web-acceptance.py и decodebench.py - см. их шапки). Копируются только два файла -
# сам тест и прибор, который он грузит: остального дерева (torrcast, conftest.py)
# машинным тестам не нужно, они не читают ничего, кроме playwright и стандартной
# библиотеки.
#
# Адрес такой машины и её окружение - деталь СРЕДЫ, а не продукта, и в отслеживаемом
# дереве не живёт (репозиторий публичный). Задаются снаружи:
#
#   TORRCAST_PROBE_HOST=user@host TORRCAST_PROBE_PYTHON=/путь/до/python3 \
#       TORRCAST_PROBE_BROWSERS_PATH=/путь/до/браузеров scripts/probe-gate
#
# TORRCAST_PROBE_HOST - обязательный, адреса по умолчанию нет и не будет.
# TORRCAST_PROBE_PYTHON - интерпретатор с playwright на той машине, по умолчанию `python3`.
# TORRCAST_PROBE_BROWSERS_PATH - не обязателен: нужен, только если браузер playwright
# на той машине лежит не в его дефолтном кэше.
#
# Красный этой команды означает то же, что красный test-gate: приёмка не объявляется.

: "${TORRCAST_PROBE_HOST:?адрес щупа не задан - экспортируй TORRCAST_PROBE_HOST=user@host}"
probe_host=$TORRCAST_PROBE_HOST
probe_python=${TORRCAST_PROBE_PYTHON:-python3}
lane_root=$(cd "$(dirname "$0")/.." && pwd)

remote_dir=$(ssh "$probe_host" mktemp -d)
[ -n "$remote_dir" ] && [ "$remote_dir" != "/" ] || exit 1
local_ini=$(mktemp)
trap 'rm -f "$local_ini"; ssh "$probe_host" "rm -rf \"$remote_dir\""' EXIT

ssh "$probe_host" "mkdir -p '$remote_dir/tests' '$remote_dir/scripts'"
scp -q "$lane_root/tests/test_web_acceptance.py" "$probe_host:$remote_dir/tests/"
scp -q "$lane_root/scripts/web-acceptance.py" "$probe_host:$remote_dir/scripts/"
# Маркер регистрируем на месте: без него pytest на щупе не видит pyproject.toml дерева
# и честно, но зря предупреждает про незнакомый `machine` при каждом прогоне.
printf '[pytest]\nmarkers =\n    machine: тест с настоящими часами, сокетом или подпроцессом\n' \
    > "$local_ini"
scp -q "$local_ini" "$probe_host:$remote_dir/pytest.ini"

browsers_env=
[ -n "${TORRCAST_PROBE_BROWSERS_PATH:-}" ] &&
    browsers_env="PLAYWRIGHT_BROWSERS_PATH='$TORRCAST_PROBE_BROWSERS_PATH'"
ssh "$probe_host" "cd '$remote_dir' && $browsers_env \
    $probe_python -m pytest tests/test_web_acceptance.py -m machine -q -rs"
