#!/bin/sh
# Договор командной строки: вывод и коды возврата команд, которые не меняются никогда.
#
#   scripts/cli-contract           сверить текущее дерево с эталоном в репозитории
#   scripts/cli-contract --save    перезаписать эталон текущим деревом
#
# Эталон лежит в `tests/fixtures/cli-contract/` и от машины не зависит: справка, версия и
# состояние путей в себе не держат. Перезаписывать его - отдельное решение: если вывод
# изменился намеренно, это видно в diff'е коммита, а не растворяется в правке.
#
# Зачем отдельно от тестов: перестройка раскладки обязана не менять продукт ни на шаг, а
# доказывать это словами «вроде тот же» нельзя. Здесь сверка ПОБАЙТОВАЯ и вместе с кодом
# возврата: `cast doctor` штатно отвечает 2, и потерять эту двойку так же плохо, как
# потерять строку вывода.
#
# Язык продукта - НАСТРОЙКА (:mod:`torrcast.domain.catalogs.tongue`), а не переменная
# среды: `TORRCAST_LANGUAGE` читает только установщик (`scripts/installer-language-
# contract` держит его отдельно). Поэтому у прибора две стороны - `en` и `ru`, - и обе
# заведены полем `language` в своём же временном `TORRCAST_CONFIG`, а не окружением.
#
# Файлы пользователя не трогаются: конфиг, состояние и лента уводятся в свой каталог.
#
# Эталон версии - ШАБЛОН (`torrcast {VERSION}`), не литерал: номер тянется из
# единственного источника (torrcast/domain/version.py, TC), иначе подъём версии красил
# бы этот эталон так же молча, как красил семь ручных мест до него.
set -eu

current_version() {
    sed -n 's/^__version__ = "\(.*\)"$/\1/p' torrcast/domain/version.py
}

mode=сверить
if [ "${1:-}" = "--save" ]; then
    mode=снять
    shift
fi
reference=${1:-tests/fixtures/cli-contract}

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT HUP INT TERM
TORRCAST_STATE="$work/state.json"
TORRCAST_LOG="$work/log"
export TORRCAST_STATE TORRCAST_LOG

# Команды без внешнего мира: справка, версия, состояние и осмотр хозяйства. Показа тут
# нет намеренно - он ходит в сеть и к телевизору, его держат тесты и живой стенд.
#
# 🔴 TC-1003. Отказ показа от непонятого флага взят сюда: он случается ДО всякой работы,
# наружу не ходит, а цена его пропажи - заведённый показ вместо ответа человеку. Даже
# уйди правка, дальше проверки «не настроен Prowlarr» такой запуск не двинется: конфиг
# тут свой и пустой, приёмника в нём нет, - и расхождение поймается выводом, а не ТВ.
run() {
    tongue=$1
    name=$2
    shift 2
    TORRCAST_CONFIG="$work/$tongue/config.json" ".venv/bin/cast" "$@" \
        > "$work/$tongue/$name.out" 2>&1 && code=0 || code=$?
    echo "$code" > "$work/$tongue/$name.rc"
}

for tongue in en ru; do
    mkdir -p "$work/$tongue"
    printf '{"language": "%s"}\n' "$tongue" > "$work/$tongue/config.json"
    run "$tongue" help --help
    run "$tongue" version --version
    run "$tongue" status status
    run "$tongue" doctor doctor
    run "$tongue" stray --since 2h
done

if [ "$mode" = снять ]; then
    for tongue in en ru; do
        mkdir -p "$reference/$tongue"
        cp "$work/$tongue"/*.rc "$reference/$tongue/"
        # Вывод осмотра в эталон не кладётся: он держит пути рабочего каталога и ответ живой
        # сети, то есть на другой машине разошёлся бы сам собой. Сверяется только его код.
        for name in help status stray; do
            cp "$work/$tongue/$name.out" "$reference/$tongue/$name.out"
        done
        sed "s/$(current_version)/{VERSION}/" "$work/$tongue/version.out" \
            > "$reference/$tongue/version.out"
        rm -f "$reference/$tongue/doctor.out"
    done
    echo "эталон снят: $reference"
    exit 0
fi

failed=0
for tongue in en ru; do
    if [ ! -d "$reference/$tongue" ]; then
        echo "нет эталона для языка $tongue: $reference/$tongue" >&2
        failed=1
        continue
    fi
    # Вывод сверяется побайтово только у команд, которые внешнего мира не касаются.
    # `cast doctor` меряет живое хозяйство - маршрут до телевизора, ответ mDNS, место на
    # диске, - и пришить его вывод к эталону значило бы объявить поломкой выключенный
    # телевизор. От него берётся код возврата: двойка на нездоровом хозяйстве - это
    # договор, а содержимое строк держит зеркало `tests/usecases/test_doctor.py`.
    for name in help status stray; do
        if ! cmp -s "$work/$tongue/$name.out" "$reference/$tongue/$name.out"; then
            echo "разошёлся вывод ($tongue): $name" >&2
            diff -u "$reference/$tongue/$name.out" "$work/$tongue/$name.out" | head -40 >&2
            failed=1
        fi
    done
    version_want="$work/$tongue/version.want"
    sed "s/{VERSION}/$(current_version)/" "$reference/$tongue/version.out" > "$version_want"
    if ! cmp -s "$work/$tongue/version.out" "$version_want"; then
        echo "разошёлся вывод ($tongue): version" >&2
        diff -u "$version_want" "$work/$tongue/version.out" | head -40 >&2
        failed=1
    fi
    for name in help version status doctor stray; do
        if ! cmp -s "$work/$tongue/$name.rc" "$reference/$tongue/$name.rc"; then
            echo "разошёлся код возврата ($tongue): $name - было" \
                "$(cat "$reference/$tongue/$name.rc"), стало $(cat "$work/$tongue/$name.rc")" >&2
            failed=1
        fi
    done
done
if [ "$failed" -ne 0 ]; then
    echo "договор командной строки нарушен" >&2
    exit 1
fi
echo "договор командной строки соблюдён: вывод четырёх запусков побайтово, коды возврата" \
    "всех пяти, на обоих языках (en, ru)"
