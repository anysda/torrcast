#!/bin/sh
# Договор языка установщика (заведён в TC-886, переставлен в TC-955):
#
#   - свежая установка без ключей пишет в конфиг язык по умолчанию (en);
#   - язык ЖИВОГО конфига повторная установка без ключей СОХРАНЯЕТ: выбор языка -
#     вкус человека (cast --ru / --en), а не замер кода, и обновление не вправе
#     его сносить;
#   - ключ -en / -ru (или TORRCAST_LANGUAGE у однострока), названный руками при
#     повторной установке, выбор менять ВПРАВЕ - для того он и набран;
#   - бутстрап `install` сносит язык через перезапуск под sudo, только если тот
#     назван: молчание однострока обязано доехать до install.sh молчанием, иначе
#     каждое обновление не-root'ом сбрасывало бы язык в дефолт.
#
# Проверки - пробы, а не грепы там, где договор о поведении: install.sh гоняется
# в песочнице (TORRCAST_NO_ROOT, фаза config с поддельным apikey Prowlarr), а
# канал sudo у бутстрапа меряется щупом за трубой `sudo -> curl | sh`, как в
# tests/test_bootstrap.py.
set -eu

fail() { printf 'installer language contract: %s\n' "$1" >&2; exit 1; }

command -v jq >/dev/null 2>&1 || fail 'jq is required'

grep -Fq -- '-en) LANGUAGE=en' install.sh || fail 'install.sh has no -en option'
grep -Fq -- '-ru) LANGUAGE=ru' install.sh || fail 'install.sh has no -ru option'
grep -Fq '"language": "$LANGUAGE"' install.sh || fail 'new config does not store language'
grep -Fq '[ -z "$4" ] || export TORRCAST_LANGUAGE="$4"' install \
    || fail 'bootstrap does not forward the named language through sudo'

# Локаль принадлежит процессам продукта, а не машине. Эти пины называют именно
# операции записи: значение LOCALE и даже чтение системных файлов договор не нарушают.
grep -Fq 'update-locale' install.sh \
    && fail 'locale phase writes the product language with update-locale'
grep -Eq '(>|>>)[[:space:]]*/etc/(default/locale|environment)' install.sh \
    && fail 'locale phase redirects the product language into a system locale file'
grep -Eq "sed_in_place .*\/etc\/(default\/locale|environment)" install.sh \
    && fail 'locale phase edits a system locale file in place'
grep -Fq "LANG='\$LOCALE'" install.sh \
    || fail 'cast wrapper does not set the product locale'
grep -Fq "LC_ALL='\$LOCALE'" install.sh \
    || fail 'cast wrapper does not pin every locale category'

# Пути и команды служб у настоящей установки остаются прежними умолчаниями, но
# контракт обязан подставлять свои. Жёсткий путь ловим ДО запуска: от root поздняя
# проверка уже не спасла бы хозяйский юнит от перезаписи.
grep -Fq 'SYSTEMD_UNIT_DIR="${TORRCAST_SYSTEMD_UNIT_DIR:-/etc/systemd/system}"' install.sh \
    || fail 'systemd unit directory is not configurable'
grep -Fq 'SYSTEMCTL="${TORRCAST_SYSTEMCTL:-systemctl}"' install.sh \
    || fail 'systemctl command is not configurable'
grep -Fq 'LAUNCHD_UNIT_DIR="${TORRCAST_LAUNCHD_UNIT_DIR:-/Library/LaunchDaemons}"' install.sh \
    || fail 'launchd unit directory is not configurable'
grep -Fq 'LAUNCHCTL="${TORRCAST_LAUNCHCTL:-launchctl}"' install.sh \
    || fail 'launchctl command is not configurable'
grep -Fq '/etc/systemd/system/' install.sh \
    && fail 'installer still uses a hard-coded systemd unit path'
grep -Fq '/Library/LaunchDaemons/' install.sh \
    && fail 'installer still uses a hard-coded launchd unit path'

box=$(mktemp -d)
trap 'rm -rf "$box"' EXIT HUP INT TERM

# --- бутстрап: названный язык переживает sudo, молчание доезжает молчанием -----
# Настоящий sudo без -E вытирает окружение молча - изображаем именно это, иначе
# проба «названный язык доехал» проходила бы на сквозняке окружения, а не на
# явном export'е внутри sh -c.
mkdir "$box/sudo-bin"
printf '#!/bin/sh\nprintf "1000\\n"\n' >"$box/sudo-bin/id"
cat >"$box/sudo-bin/sudo" <<'SH'
#!/bin/sh
exec env -i PATH="$PATH" "$@"
SH
cat >"$box/sudo-bin/curl" <<SH
#!/bin/sh
cat <<'PROBE'
#!/bin/sh
printf 'LANGUAGE=%s\n' "\${TORRCAST_LANGUAGE:-<unset>}" >>"$box/observed"
PROBE
SH
chmod +x "$box/sudo-bin/id" "$box/sudo-bin/sudo" "$box/sudo-bin/curl"

PATH="$box/sudo-bin:$PATH" sh ./install >/dev/null 2>&1 \
    || fail 'bootstrap run failed'
grep -Fq 'LANGUAGE=<unset>' "$box/observed" \
    || fail 'bootstrap exports a default language through sudo - silence must stay silence'

: >"$box/observed"
PATH="$box/sudo-bin:$PATH" TORRCAST_LANGUAGE=ru sh ./install >/dev/null 2>&1 \
    || fail 'bootstrap run with a named language failed'
grep -Fq 'LANGUAGE=ru' "$box/observed" \
    || fail 'bootstrap did not pass the named language through sudo'

# --- install.sh: язык живого конфига сохраняется, названный ключ его меняет ----
mkdir -p "$box/p/prowlarr-data"
printf '<Config><ApiKey>sandboxkey</ApiKey></Config>\n' >"$box/p/prowlarr-data/config.xml"

run_config() {  # $@ - ключи install.sh
    TORRCAST_NO_ROOT=1 TORRCAST_NO_SYSTEMD=1 TORRCAST_PHASES=config \
        TORRCAST_PREFIX="$box/p" TORRCAST_CONFIG_DIR="$box/etc" \
        TORRCAST_STATE_DIR="$box/state" TORRCAST_BIN_DIR="$box/bin" \
        TORRCAST_MOTD="$box/motd" TORRCAST_MOTD_D="$box/motd.d" \
        ./install.sh "$@" >"$box/config.out" 2>&1
}

run_config || fail 'fresh sandbox install failed'
[ "$(jq -r .language "$box/etc/config.json")" = en ] \
    || fail 'fresh install without keys did not store en'

# Выбор человека продуктом: cast --ru пишет в этот же конфиг.
jq '.language="ru"' "$box/etc/config.json" >"$box/etc/config.json.tmp"
mv "$box/etc/config.json.tmp" "$box/etc/config.json"

run_config || fail 'reinstall without keys failed'
[ "$(jq -r .language "$box/etc/config.json")" = ru ] \
    || fail 'reinstall without keys dropped the chosen language (TC-955)'

run_config -en || fail 'reinstall with -en failed'
[ "$(jq -r .language "$box/etc/config.json")" = en ] \
    || fail 'a named -en key did not change the language'

# --- службы и язык собственного вывода установщика -----------------------------
# Первый PATH ловит всякий забытый голый вызов. Настроенные менеджеры лежат в другом
# каталоге и пишут отдельную ленту: зелень тем самым доказывает не просто «команда
# ответила», а что установщик дошёл именно до подставленного менеджера.
mkdir -p "$box/path-spy" "$box/service-bin"
cat >"$box/path-spy/systemctl" <<SH
#!/bin/sh
printf '%s\n' "\$*" >>"$box/host-systemctl.calls"
exit 97
SH
cat >"$box/path-spy/launchctl" <<SH
#!/bin/sh
printf '%s\n' "\$*" >>"$box/host-launchctl.calls"
exit 97
SH
cat >"$box/service-bin/systemctl" <<SH
#!/bin/sh
printf '%s\n' "\$*" >>"$box/sandbox-systemctl.calls"
[ "\${1:-}" != is-active ]
SH
cat >"$box/service-bin/launchctl" <<SH
#!/bin/sh
printf '%s\n' "\$*" >>"$box/sandbox-launchctl.calls"
[ "\${1:-}" != print ]
SH
chmod +x "$box/path-spy/systemctl" "$box/path-spy/launchctl" \
    "$box/service-bin/systemctl" "$box/service-bin/launchctl"
: >"$box/host-systemctl.calls"
: >"$box/host-launchctl.calls"
: >"$box/sandbox-systemctl.calls"
: >"$box/sandbox-launchctl.calls"
PATH="$box/path-spy:$PATH"
export PATH

mkdir -p "$box/service/etc" "$box/service/prowlarr-data" \
    "$box/systemd-absent" "$box/systemd-present" "$box/launchd"
printf '<Config><ApiKey>sandboxkey</ApiKey></Config>\n' \
    >"$box/service/prowlarr-data/config.xml"

run_units() {  # $1 каталог systemd, $2 вывод
    unit_dir=$1
    output=$2
    shift 2
    rm -f "$box/service/etc/config.json"
    TORRCAST_NO_ROOT=1 TORRCAST_PHASES=config \
        TORRCAST_PREFIX="$box/service" TORRCAST_CONFIG_DIR="$box/service/etc" \
        TORRCAST_STATE_DIR="$box/service/state" TORRCAST_BIN_DIR="$box/service/bin" \
        TORRCAST_MOTD="$box/service/motd" TORRCAST_MOTD_D="$box/service/motd.d" \
        TORRCAST_SYSTEMD_UNIT_DIR="$unit_dir" \
        TORRCAST_SYSTEMCTL="$box/service-bin/systemctl" \
        TORRCAST_LAUNCHD_UNIT_DIR="$box/launchd" \
        TORRCAST_LAUNCHCTL="$box/service-bin/launchctl" \
        ./install.sh "$@" >"$output" 2>&1
}

# Одинаковый пользовательский заход при пустом каталоге и при двух старых юнитах.
run_units "$box/systemd-absent" "$box/absent.out" \
    || fail 'service install with an empty unit directory failed'
printf 'old bot unit\n' >"$box/systemd-present/torrcast-bot.service"
printf 'old bridge unit\n' >"$box/systemd-present/torrcast-ha.service"
run_units "$box/systemd-present" "$box/present.out" \
    || fail 'service install with existing units failed'
cmp -s "$box/absent.out" "$box/present.out" \
    || fail 'service result depends on units already present in the configured directory'
for units in "$box/systemd-absent" "$box/systemd-present"; do
    grep -Fq 'ExecStart=' "$units/torrcast-bot.service" \
        || fail 'bot unit was not written to the configured directory'
    grep -Fq 'ExecStart=' "$units/torrcast-ha.service" \
        || fail 'bridge unit was not written to the configured directory'
done
grep -Fq 'enable --now torrcast-ha.service' "$box/sandbox-systemctl.calls" \
    || fail 'configured systemctl was not used to enable the bridge'
[ ! -s "$box/host-systemctl.calls" ] \
    || fail 'installer called systemctl from the host PATH'

# Та же граница для macOS: поддельный uname проводит ровно ветку launchd, а каталог
# plist и launchctl остаются внутри той же песочницы.
cat >"$box/path-spy/uname" <<'SH'
#!/bin/sh
case "${1:-}" in -m) printf 'arm64\n' ;; *) printf 'Darwin\n' ;; esac
SH
chmod +x "$box/path-spy/uname"
run_units "$box/systemd-absent" "$box/macos.out" \
    || fail 'service install through the launchd branch failed'
grep -Fq 'ExecStart=' "$box/systemd-absent/torrcast-ha.service" \
    || fail 'Linux unit changed while probing launchd'
grep -Fq '<key>ProgramArguments</key>' "$box/launchd/org.torrcast.torrcast-bot.plist" \
    || fail 'bot plist was not written to the configured directory'
grep -Fq '<key>ProgramArguments</key>' "$box/launchd/org.torrcast.torrcast-ha.plist" \
    || fail 'bridge plist was not written to the configured directory'
grep -Fq 'bootstrap system' "$box/sandbox-launchctl.calls" \
    || fail 'configured launchctl was not used to bootstrap the bridge'
[ ! -s "$box/host-launchctl.calls" ] \
    || fail 'installer called launchctl from the host PATH'

# Языковые стороны отключают службы явно: их договор только о словах приёмника.
mv "$box/path-spy/uname" "$box/path-spy/uname.macos"
mkdir -p "$box/en/etc" "$box/en/bin" "$box/ru/etc" "$box/ru/bin"
printf '{"tv": null}\n' >"$box/en/etc/config.json"
printf '{"tv": null}\n' >"$box/ru/etc/config.json"
printf '#!/bin/sh\nexit 1\n' >"$box/en/bin/cast"
cp "$box/en/bin/cast" "$box/ru/bin/cast"
chmod +x "$box/en/bin/cast" "$box/ru/bin/cast"
TORRCAST_NO_ROOT=1 TORRCAST_NO_SYSTEMD=1 TORRCAST_PHASES=receiver \
    TORRCAST_PREFIX="$box/en" TORRCAST_CONFIG_DIR="$box/en/etc" \
    TORRCAST_STATE_DIR="$box/en/state" TORRCAST_BIN_DIR="$box/en/bin" \
    TORRCAST_MOTD="$box/en/motd" TORRCAST_MOTD_D="$box/en/motd.d" \
    ./install.sh >"$box/en.out" 2>&1
TORRCAST_NO_ROOT=1 TORRCAST_NO_SYSTEMD=1 TORRCAST_PHASES=receiver \
    TORRCAST_PREFIX="$box/ru" TORRCAST_CONFIG_DIR="$box/ru/etc" \
    TORRCAST_STATE_DIR="$box/ru/state" TORRCAST_BIN_DIR="$box/ru/bin" \
    TORRCAST_MOTD="$box/ru/motd" TORRCAST_MOTD_D="$box/ru/motd.d" \
    ./install.sh -ru >"$box/ru.out" 2>&1
LC_ALL=C grep -q '[А-яЁё]' "$box/en.out" && fail 'English output contains Cyrillic'
grep -Fq 'no receiver selected; run cast --tv <ip>' "$box/en.out" \
    || fail 'English failure reason is not named'
LC_ALL=C grep -q '[А-яЁё]' "$box/ru.out" || fail 'Russian output contains no Cyrillic'
iconv -f UTF-8 -t UTF-8 "$box/ru.out" >/dev/null || fail 'Russian output is not valid UTF-8'
if ./install.sh -unknown >"$box/unknown.out" 2>&1; then
    fail 'unknown option was accepted'
else
    code=$?
fi
[ "$code" -eq 2 ] || fail "unknown option returned $code instead of 2"
printf 'installer language contract: language and sudo are preserved; service units and managers stay in the sandbox\n'
