#!/bin/sh
set -eu

# Логические процессоры делят независимые тесты; настоящие часы, сокеты, подпроцессы
# и живой медиатракт не конкурируют за машину. Две команды покрывают всю коллекцию.
limit=1500
for file in torrcast/*.py; do
    lines=$(wc -l < "$file")
    if [ "$lines" -gt "$limit" ]; then
        echo "слишком длинный файл: $file — $lines строк, порог $limit" >&2
        exit 1
    fi
done

.venv/bin/ruff check
.venv/bin/ruff format --check
.venv/bin/mypy
.venv/bin/python -m pytest -m 'not ffmpeg and not machine' -n logical

# Сторож использует ffmpeg, поэтому живёт в ffmpeg-овой стадии. Без аргументов он
# проверяет оба пути нашего упаковщика; готовые куски аргументами оставляют прежнюю
# отрицательную пробу той же командой.
seam_dir=
if [ "$#" -eq 0 ]; then
    seam_dir=$(mktemp -d)
    trap 'rm -rf "$seam_dir"' EXIT HUP INT TERM
    # Секунда запаса перед первой границей сохраняет задержку AAC: без неё muxer прижимает первый
    # отрицательный пакет к нулю и сам создаёт ложный нахлёст на первом стыке.
    ffmpeg -hide_banner -loglevel error -y \
        -f lavfi -i testsrc=size=64x64:rate=25:duration=28.8 \
        -f lavfi -i sine=frequency=1000:sample_rate=48000:duration=28.8 \
        -map 0:v -map 1:a -pix_fmt yuv420p -c:v libx264 -preset ultrafast -g 240 \
        -c:a ac3 -ac 2 -output_ts_offset 1 \
        "$seam_dir/source.mkv"
    .venv/bin/python - "$seam_dir" <<'PY'
from pathlib import Path
import subprocess
import sys

from torrcast.recode import Encode, FULL_PRESET
from torrcast.stream import Grid, ffmpeg_pack_command


root = Path(sys.argv[1])
source = root / "source.mkv"
grid = Grid((0.0, 9.6, 19.2), 28.8, on_keys=True)
# Прогон встаёт на 1.0: ровно там стоит первый пакет запаса. Соврать здесь нулём -
# развалить перекодирующий путь: время реза муксер считает от начала прогона, а опорные
# кадры кодировщик ставит по абсолютному времени, и эта секунда разницы уводит границы
# с сетки (замер: куски 19.2 / 10.0 / 0.6 с вместо 9.6 / 9.6 / 10.6).
for name, encode in (("copy", None), ("recode", Encode(preset=FULL_PRESET, mbit=1.0))):
    run = root / name
    run.mkdir()
    command = ffmpeg_pack_command(
        str(source), 0, str(run), grid, 0, 1.0, readrate=0.0, encode=encode
    )
    subprocess.run(command, check=True)
PY
    set -- "$seam_dir"/copy/v*.ts -- "$seam_dir"/recode/v*.ts
fi

.venv/bin/python - "$@" <<'PY'
from __future__ import annotations

import json
from pathlib import Path
import subprocess
import sys


def packets(path: Path) -> dict[str, list[float]]:
    probe = subprocess.run(
        [
            "ffprobe",
            "-v",
            "error",
            "-show_packets",
            "-show_streams",
            "-of",
            "json",
            str(path),
        ],
        check=True,
        capture_output=True,
        text=True,
    )
    data = json.loads(probe.stdout)
    kinds = {stream["index"]: stream["codec_type"] for stream in data["streams"]}
    found: dict[str, list[float]] = {"video": [], "audio": []}
    for packet in data["packets"]:
        kind = kinds.get(packet["stream_index"])
        if kind in found and "dts_time" in packet:
            found[kind].append(float(packet["dts_time"]))
    return found


broken = False
groups = [[]]
for name in sys.argv[1:]:
    if name == "--":
        groups.append([])
    else:
        groups[-1].append(Path(name))
for pieces in groups:
    if len(pieces) < 2:
        raise SystemExit("сторожу стыков нужно хотя бы два куска")
    timeline = [packets(piece) for piece in pieces]
    for seam, (left, right) in enumerate(zip(timeline, timeline[1:]), start=1):
        for stream, label in (("video", "видео"), ("audio", "звук")):
            if not left[stream] or not right[stream]:
                continue
            rollback = max(left[stream]) - min(right[stream])
            if rollback >= 0:
                print(f"стык {seam}: {label}, откат {rollback:.3f} с", file=sys.stderr)
                broken = True
if broken:
    raise SystemExit(1)
PY

.venv/bin/python -m pytest -m 'ffmpeg or machine' -n 0
