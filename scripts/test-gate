#!/bin/sh
set -eu

# Разрез на слои закончен, нарушений ноль по всем правилам: сторож переключён из
# режима отчёта в блокирующий. Без --strict он печатает список и возвращает ноль, то
# есть раскладка расползается обратно молча. Порог длины тут ровно один - правило
# `длина` внутри гейта, и оно меряет всё дерево, а не только верх пакета.
scripts/structure-gate --strict
scripts/cli-contract

# Мёртвое «в большом» - имя без вызывающих и модуль без импортирующих - не видит ни
# ruff, ни mypy: те смотрят внутрь модуля, а вопрос тут ко всему дереву. Три стадии, у
# каждой свой охват, и охват там - это и есть смысл стадии; сказано об этом в ней самой.
# Стоит она сразу за раскладкой: считается шесть секунд, а работу режет рано.
scripts/dead-code

# Зеркала проводок (tests/runtime/test_wire*.py) обязаны сверять каждый слот по САМОМУ
# значению: «вызываемо ли» договору отвечает и пустышка - живая проба с
# `lambda _piece, _out: None` на месте укладки заголовка держала весь набор зелёным.
# Список слотов сторож не держит руками ни для одной проводки: он сам сличает доводы,
# которые проводка кладёт в свои настройщики, с тем, что сверяет зеркало, - и слот без
# такой сверки (нынешний пропуск или будущий новый) гейт не пропускает.
.venv/bin/python - <<'PY'
import ast
from pathlib import Path

#: Проводка и её зеркало. Корень (`wire.py`) ставит слоты иначе - см. `ROOT` ниже.
WIRINGS = {
    "torrcast/runtime/wire_feed.py": "tests/runtime/test_wire_feed.py",
    "torrcast/runtime/wire_show.py": "tests/runtime/test_wire_show.py",
    "torrcast/runtime/wire_search.py": "tests/runtime/test_wire_search.py",
}


def tree(path: str) -> ast.Module:
    return ast.parse(Path(path).read_text(encoding="utf-8"), filename=path)


def imports(mod: ast.Module) -> dict[str, tuple[str, str]]:
    """Как имя зовётся здесь -> (модуль, как оно зовётся там)."""
    out: dict[str, tuple[str, str]] = {}
    for node in ast.walk(mod):
        if isinstance(node, ast.ImportFrom) and node.module:
            for alias in node.names:
                out[alias.asname or alias.name] = (node.module, alias.name)
        elif isinstance(node, ast.Import):
            for alias in node.names:
                out[alias.asname or alias.name] = (alias.name, "")
    return out


def path_of(module: str) -> str | None:
    for candidate in (module.replace(".", "/") + ".py", module.replace(".", "/") + "/__init__.py"):
        if Path(candidate).exists():
            return candidate
    return None


def function(mod: ast.Module, name: str) -> ast.FunctionDef | None:
    for node in mod.body:
        if isinstance(node, ast.FunctionDef) and node.name == name:
            return node
    return None


def slots_of(func: ast.FunctionDef) -> dict[tuple[str, str | None], tuple[str | None, str]]:
    """Куда ложится каждый довод: (довод, поле) -> (чьё состояние, имя слота).

    Две формы, обе живые: `_state.SLOT = довод` у ленты и глобальное `SLOT = среда.поле`
    у показа, где модуль состояния сам себе хранилище (тогда «чьё» - None).
    """
    out: dict[tuple[str, str | None], tuple[str | None, str]] = {}
    for node in ast.walk(func):
        if not isinstance(node, ast.Assign) or len(node.targets) != 1:
            continue
        target, value = node.targets[0], node.value
        if isinstance(target, ast.Attribute) and isinstance(target.value, ast.Name):
            where: tuple[str | None, str] = (target.value.id, target.attr)
        elif isinstance(target, ast.Name):
            where = (None, target.id)
        else:
            continue
        if isinstance(value, ast.Name):
            out[(value.id, None)] = where
        elif isinstance(value, ast.Attribute) and isinstance(value.value, ast.Name):
            out[(value.value.id, value.attr)] = where
    return out


def expected(argument: ast.expr) -> str:
    """Чем слот сверяется: своим значением, а у свежего экземпляра - точным классом.

    Экземпляр проводка собирает прямо в доводе (`PrintConsole()`), тождества у него не
    бывает ни с чем - поэтому договор тут другой: `type(слот) is Класс`. Ослаблением это
    не является, пустышку он ловит ровно так же.
    """
    if isinstance(argument, ast.Call) and isinstance(argument.func, ast.Name):
        return f"класс {argument.func.id}"
    return ast.unparse(argument)


def wanted(wiring: str) -> dict[tuple[str, str], str]:
    """Что проводка кладёт в каждый слот: (модуль состояния, слот) -> выражение."""
    mod = tree(wiring)
    known = imports(mod)
    out: dict[tuple[str, str], str] = {}
    for node in ast.walk(mod):
        if not isinstance(node, ast.Call) or not isinstance(node.func, ast.Name):
            continue
        here = known.get(node.func.id)
        if here is None or not here[0].startswith("torrcast."):
            continue
        state_module, there = here
        state_path = path_of(state_module)
        if state_path is None:
            continue
        setter_module = tree(state_path)
        setter = function(setter_module, there)
        if setter is None:
            continue
        # Слот живёт либо в соседнем модуле состояния (`_state.X`), либо в самом
        # модуле настройщика (`X = среда.поле` под `global`).
        holders = imports(setter_module)
        places = slots_of(setter)
        if not places:
            continue
        params = [arg.arg for arg in setter.args.args]
        for index, argument in enumerate(node.args):
            if index >= len(params):
                break
            param = params[index]
            if (param, None) in places:
                holder, slot = places[(param, None)]
                keeper = holders.get(holder, (state_module, ""))[0] if holder else state_module
                out[(keeper, slot)] = expected(argument)
            # Договор одним мешком: слот берёт поле, а проводка называет его словом.
            if isinstance(argument, ast.Call):
                for keyword in argument.keywords:
                    if keyword.arg and (param, keyword.arg) in places:
                        holder, slot = places[(param, keyword.arg)]
                        keeper = (
                            holders.get(holder, (state_module, ""))[0] if holder else state_module
                        )
                        out[(keeper, slot)] = expected(keyword.value)
    return out


def found(mirror: str) -> dict[tuple[str, str], str]:
    """Что зеркало сверяет по значению: (модуль состояния, слот) -> выражение."""
    mod = tree(mirror)
    known = imports(mod)
    out: dict[tuple[str, str], str] = {}
    for node in ast.walk(mod):
        if not isinstance(node, ast.Compare) or len(node.ops) != 1:
            continue
        if not isinstance(node.ops[0], ast.Is | ast.Eq):
            continue
        left, right = node.left, node.comparators[0]
        # `type(слот) is Класс` - сверка свежего экземпляра; читается тот же слот.
        by_class = (
            isinstance(left, ast.Call)
            and isinstance(left.func, ast.Name)
            and left.func.id == "type"
            and len(left.args) == 1
        )
        if by_class:
            left = left.args[0]
        if not isinstance(left, ast.Attribute) or not isinstance(left.value, ast.Name):
            continue
        where = known.get(left.value.id)
        if where is None:
            continue
        out[(where[0], left.attr)] = (
            f"класс {ast.unparse(right)}" if by_class else ast.unparse(right)
        )
    return out


blind = []
total = 0
for wiring, mirror in WIRINGS.items():
    asked, seen = wanted(wiring), found(mirror)
    total += len(asked)
    for (state_module, slot), value in sorted(asked.items()):
        if seen.get((state_module, slot)) != value:
            blind.append(
                f"{Path(mirror).name}: {state_module}.{slot} - проводка кладёт {value}, "
                f"а зеркало сверяет {seen.get((state_module, slot), 'ничего')}"
            )

if blind:
    raise SystemExit("зеркало проводки слепо к подмене:\n" + "\n".join(blind))
print(f"зеркала проводок сверяют по значению слотов: {total}")
PY

.venv/bin/ruff check
.venv/bin/ruff format --check
# Без --no-incremental mypy отвечает из .mypy_cache и пропускает поломку, которую
# сам же нашёл бы на чистом дереве: 16-08-2026 гейт так держался зелёным на
# отсутствующем модуле. Гейт обязан мерить дерево, а не кэш.
.venv/bin/mypy --no-incremental
# Логические процессоры делят независимые тесты; настоящие часы, сокеты, подпроцессы
# и живой медиатракт не конкурируют за машину. Две команды покрывают всю коллекцию.
.venv/bin/python -m pytest -m 'not ffmpeg and not machine' -n logical

# Сторож использует ffmpeg, поэтому живёт в ffmpeg-овой стадии. Без аргументов он
# проверяет оба пути нашего упаковщика и то, что уезжает зрителю; готовые куски
# аргументами оставляют прежнюю отрицательную пробу той же командой.
seam_dir=
if [ "$#" -eq 0 ]; then
    seam_dir=$(mktemp -d)
    trap 'rm -rf "$seam_dir"' EXIT HUP INT TERM
    # 🔴 23.976 к/с, а не ровные 25, и это не вкус, а условие видимости целого класса.
    # Рез муксер отмеряет от первого пакета прогона, а тот встаёт на первый кадр не
    # раньше границы - то есть на долю кадра позже неё. На 25 к/с кадры стоят через
    # 0.04 с и границы десятисекундной сетки делят нацело: доля выходит нулевая, рез с
    # опорным кадром не расходится ни разу, и разницы между сеткой по кадрам и ровной
    # на таком входе не видно вовсе. На 23.976 к/с доля ненулевая, и куски обеих сеток
    # начинаются тем, чем начинаются, - а сторож ниже смотрит ровно на это.
    ffmpeg -hide_banner -loglevel error -y \
        -f lavfi -i testsrc2=size=320x180:rate=24000/1001 \
        -f lavfi -i sine=frequency=440 -t 60 \
        -c:v libx264 -preset ultrafast -g 50 -bf 3 \
        -c:a aac -movflags +faststart "$seam_dir/source.mp4"
    # Сторож - тот же прогон, что и набор, и состояние у него своё, а не боевое: карта
    # опорных кадров ложится на полку в момент снятия (:func:`film_keys`), а голый питон
    # мимо pytest песочница фикстур (tests/conftest.pytest_configure) не накрывает, и
    # запись садилась на боевую полку карт. -B - чтобы байт-код импортов не считался
    # попаданием: pycache пишется рядом с кодом, то есть мимо песочницы.
    TORRCAST_STATE="$seam_dir/state.json" .venv/bin/python -B - "$seam_dir" <<'PY'
import io
import os
from pathlib import Path
import subprocess
import sys

root = Path(sys.argv[1]).resolve()

# Перехватчик записи: любая запись мимо песочницы сторожа - в боевое состояние машины.
# Набор такую запись ловит песочницей процесса, этот прогон голый - поэтому попадания он
# считает сам, и ноль у него доказан отрицательной пробой: с песочницей, сломанной
# нарочно (TORRCAST_STATE снаружи seam_dir), сторож краснеет именно на этом списке.
stray: list[str] = []


def _outside(path: object) -> str | None:
    """Путь записи, лежащий вне песочницы сторожа; ``None`` - внутри."""
    full = Path(os.fspath(path))
    if not full.is_absolute():
        full = Path.cwd() / full
    resolved = full.resolve()
    return None if resolved == root or root in resolved.parents else str(resolved)


_real_open = os.open


def _watched_os_open(path: object, flags: int, *args: object, **kwargs: object) -> int:
    if flags & (os.O_WRONLY | os.O_RDWR | os.O_CREAT | os.O_TRUNC | os.O_APPEND):
        if (hit := _outside(path)) is not None:
            stray.append(f"os.open: {hit}")
    return _real_open(path, flags, *args, **kwargs)


os.open = _watched_os_open

for _name in ("replace", "rename", "unlink", "mkdir", "rmdir", "utime", "symlink", "link"):
    _real = getattr(os, _name)

    def _watched(*paths: object, _real=_real, _name=_name, **kwargs: object) -> object:
        for _path in paths:
            if isinstance(_path, (str, bytes, os.PathLike)):
                if (hit := _outside(_path)) is not None:
                    stray.append(f"{_name}: {hit}")
        return _real(*paths, **kwargs)

    setattr(os, _name, _watched)

_real_io_open = io.open


def _watched_io_open(file: object, mode: str = "r", *args: object, **kwargs: object) -> object:
    if isinstance(file, (str, bytes, os.PathLike)) and any(mark in mode for mark in "wax+"):
        if (hit := _outside(file)) is not None:
            stray.append(f"open: {hit}")
    return _real_io_open(file, mode, *args, **kwargs)


io.open = _watched_io_open

from torrcast.adapters.recode.encode import Encode
from torrcast.adapters.recode.whole_encode import FULL_PRESET
from torrcast.adapters.stream_pack.ffmpeg_pack_command import ffmpeg_pack_command
from torrcast.adapters.stream_pack.grid import Grid
from torrcast.adapters.stream_pack.grid_for import grid_for
from torrcast.adapters.stream_pack.packer import Packer

#: Заход кодировщика: с какого куска сетки и по какой. Кусок без опорного кадра берётся
#: на ВНУТРЕННИХ границах захода, поэтому одной границы тут мало, а начинаться заход
#: обязан не с нуля: своё место в ленте ему задаёт ``-ss``, и от него же считается
#: кадровая сетка кодировщика.
FIRST, LAST = 1, 3


class _Exited:
    """Процесс упаковки, вышедший нулём: больше выкладка о нём ничего не спрашивает.

    Сетки у прогона тут нет, поэтому «дописан ли последний кусок» решает один этот код
    (:meth:`Packer.finished`), и решает верно: оба захода отработаны до конца.
    """

    def poll(self) -> int:
        return 0


source_url = (root / "source.mp4").as_uri()
recode = Encode(preset=FULL_PRESET, mbit=1.0)


def pack(name: str, grid: Grid, encode: Encode | None, slot: int, until: int) -> Path:
    """Упаковать заход по сетке ``grid`` и вернуть каталог с его кусками."""
    run = root / name
    run.mkdir()
    command = ffmpeg_pack_command(
        source_url,
        0,
        str(run),
        grid,
        slot,
        grid.start(slot),
        readrate=0.0,
        encode=encode,
        until=until,
    )
    subprocess.run(command, check=True)
    return run


grid = grid_for(source_url, 60.0)
if not grid.on_keys or grid.origin <= 0:
    raise SystemExit("сторожу нужна сетка по опорным кадрам и начало ленты ниже нуля")
pack("copy", grid, None, 0, 0)
pack("recode", grid, recode, 0, 0)

# Вторая половина входа - РОВНАЯ сетка: на ней рез идёт по времени, а не по кадру, и
# принудительный опорный кадр вправе лечь по ту сторону границы. Дальше куски идут не
# в пробу, а настоящей выкладкой упаковщика: мера тут одна и она про зрителя - что
# именно уехало наружу, копия, склейка или ничего.
flat = grid_for(source_url, 60.0, on_keys=False)
# Копия идёт с нуля, а заход кодировщика - с ``FIRST``, и это не экономия строк: у
# копии ``-ss`` уводит первый пакет на опорный кадр РАНЬШЕ границы (докатка), и её
# место в ленте считает показ (:func:`pack_start`), а не сетка. Перекодирующий ffmpeg
# встаёт по ``-ss`` точно и докатки не делает - ему граница и есть начало.
run = pack("flat-copy", flat, None, 0, LAST)
spare = pack("flat-recode", flat, recode, FIRST, LAST)
out = root / "out"
out.mkdir()
Packer(proc=_Exited(), out=out, run=run, spare=spare, last=LAST).publish()

if stray:
    raise SystemExit(
        "сторож шва пишет мимо своей песочницы:\n" + "\n".join(sorted(set(stray)))
    )
PY
    set -- "$seam_dir"/copy/v*.ts -- "$seam_dir"/recode/v*.ts -- "$seam_dir"/out/v*.ts
fi

.venv/bin/python - "$@" <<'PY'
from __future__ import annotations

import json
from pathlib import Path
import subprocess
import sys


def packets(path: Path) -> dict[str, list[float]]:
    probe = subprocess.run(
        [
            "ffprobe",
            "-v",
            "error",
            "-show_packets",
            "-show_streams",
            "-of",
            "json",
            str(path),
        ],
        check=True,
        capture_output=True,
        text=True,
    )
    data = json.loads(probe.stdout)
    kinds = {stream["index"]: stream["codec_type"] for stream in data["streams"]}
    found: dict[str, list[float]] = {"video": [], "audio": []}
    for packet in data["packets"]:
        kind = kinds.get(packet["stream_index"])
        if kind in found and "dts_time" in packet:
            found[kind].append(float(packet["dts_time"]))
    return found


broken = False
groups = [[]]
for name in sys.argv[1:]:
    if name == "--":
        groups.append([])
    else:
        groups[-1].append(Path(name))
# Ход ленты сверяется на всех трёх плечах, и выложенное зрителю - главное из них: это
# ровно тот поток, который разбирает приёмник, и «метка назад» в нём стоит показа.
# Куски там разных производителей (копия и склейка), но лента у них одна - фильма, -
# потому что оба захода пакуют её метки как есть (``-copyts`` и общий ``origin``).
SEAMS = ("упаковка копией", "непрерывность перекода", "выкладка зрителю")
for leg, pieces in zip(SEAMS, groups):
    if len(pieces) < 2:
        raise SystemExit("сторожу стыков нужно хотя бы два куска")
    timeline = [packets(piece) for piece in pieces]
    for piece, found in zip(pieces, timeline):
        # 🔴 TC-698. Кусок без единого видеопакета - это не «кусок похуже», а десять
        # секунд звука на чёрном экране. Сверке хода ленты он невидим ПО ПОСТРОЕНИЮ: у
        # такого куска нет ни первой метки, ни последней, сверять нечего, и ветка ниже
        # молча его пропускает. Ровно поэтому он уезжал зрителю при зелёном гейте.
        if not found["video"]:
            print(f"{leg}: {piece.name} - ни одного видеокадра", file=sys.stderr)
            broken = True
    for seam, (left, right) in enumerate(zip(timeline, timeline[1:]), start=1):
        for stream, label in (("video", "видео"), ("audio", "звук")):
            if not left[stream] or not right[stream]:
                continue
            rollback = max(left[stream]) - min(right[stream])
            if rollback >= 0:
                print(f"{leg}, стык {seam}: {label}, откат {rollback:.3f} с", file=sys.stderr)
                broken = True
if broken:
    raise SystemExit(1)
PY

.venv/bin/python -m pytest -m 'ffmpeg or machine' -n 0
