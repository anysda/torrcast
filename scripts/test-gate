#!/bin/sh
set -eu

# Разрез на слои закончен, нарушений ноль по всем правилам: сторож переключён из
# режима отчёта в блокирующий. Без --strict он печатает список и возвращает ноль, то
# есть раскладка расползается обратно молча. Порог длины тут ровно один - правило
# `длина` внутри гейта, и оно меряет всё дерево, а не только верх пакета.
scripts/structure-gate --strict
scripts/cli-contract

.venv/bin/ruff check
.venv/bin/ruff format --check
# Без --no-incremental mypy отвечает из .mypy_cache и пропускает поломку, которую
# сам же нашёл бы на чистом дереве: 16-08-2026 гейт так держался зелёным на
# отсутствующем модуле. Гейт обязан мерить дерево, а не кэш.
.venv/bin/mypy --no-incremental
# Логические процессоры делят независимые тесты; настоящие часы, сокеты, подпроцессы
# и живой медиатракт не конкурируют за машину. Две команды покрывают всю коллекцию.
.venv/bin/python -m pytest -m 'not ffmpeg and not machine' -n logical

# Сторож использует ffmpeg, поэтому живёт в ffmpeg-овой стадии. Без аргументов он
# проверяет оба пути нашего упаковщика и то, что уезжает зрителю; готовые куски
# аргументами оставляют прежнюю отрицательную пробу той же командой.
seam_dir=
if [ "$#" -eq 0 ]; then
    seam_dir=$(mktemp -d)
    trap 'rm -rf "$seam_dir"' EXIT HUP INT TERM
    # 🔴 23.976 к/с, а не ровные 25, и это не вкус, а условие видимости целого класса.
    # Рез муксер отмеряет от первого пакета прогона, а тот встаёт на первый кадр не
    # раньше границы - то есть на долю кадра позже неё. На 25 к/с кадры стоят через
    # 0.04 с и границы десятисекундной сетки делят нацело: доля выходит нулевая, рез с
    # опорным кадром не расходится ни разу, и разницы между сеткой по кадрам и ровной
    # на таком входе не видно вовсе. На 23.976 к/с доля ненулевая, и куски обеих сеток
    # начинаются тем, чем начинаются, - а сторож ниже смотрит ровно на это.
    ffmpeg -hide_banner -loglevel error -y \
        -f lavfi -i testsrc2=size=320x180:rate=24000/1001 \
        -f lavfi -i sine=frequency=440 -t 60 \
        -c:v libx264 -preset ultrafast -g 50 -bf 3 \
        -c:a aac -movflags +faststart "$seam_dir/source.mp4"
    .venv/bin/python - "$seam_dir" <<'PY'
from pathlib import Path
import subprocess
import sys

from torrcast.adapters.recode.encode import Encode
from torrcast.adapters.recode.whole_encode import FULL_PRESET
from torrcast.adapters.stream_pack.ffmpeg_pack_command import ffmpeg_pack_command
from torrcast.adapters.stream_pack.grid import Grid
from torrcast.adapters.stream_pack.grid_for import grid_for
from torrcast.adapters.stream_pack.packer import Packer

#: Заход кодировщика: с какого куска сетки и по какой. Кусок без опорного кадра берётся
#: на ВНУТРЕННИХ границах захода, поэтому одной границы тут мало, а начинаться заход
#: обязан не с нуля: своё место в ленте ему задаёт ``-ss``, и от него же считается
#: кадровая сетка кодировщика.
FIRST, LAST = 1, 3


class _Exited:
    """Процесс упаковки, вышедший нулём: больше выкладка о нём ничего не спрашивает.

    Сетки у прогона тут нет, поэтому «дописан ли последний кусок» решает один этот код
    (:meth:`Packer.finished`), и решает верно: оба захода отработаны до конца.
    """

    def poll(self) -> int:
        return 0


root = Path(sys.argv[1])
source_url = (root / "source.mp4").as_uri()
recode = Encode(preset=FULL_PRESET, mbit=1.0)


def pack(name: str, grid: Grid, encode: Encode | None, slot: int, until: int) -> Path:
    """Упаковать заход по сетке ``grid`` и вернуть каталог с его кусками."""
    run = root / name
    run.mkdir()
    command = ffmpeg_pack_command(
        source_url,
        0,
        str(run),
        grid,
        slot,
        grid.start(slot),
        readrate=0.0,
        encode=encode,
        until=until,
    )
    subprocess.run(command, check=True)
    return run


grid = grid_for(source_url, 60.0)
if not grid.on_keys or grid.origin <= 0:
    raise SystemExit("сторожу нужна сетка по опорным кадрам и начало ленты ниже нуля")
pack("copy", grid, None, 0, 0)
pack("recode", grid, recode, 0, 0)

# Вторая половина входа - РОВНАЯ сетка: на ней рез идёт по времени, а не по кадру, и
# принудительный опорный кадр вправе лечь по ту сторону границы. Дальше куски идут не
# в пробу, а настоящей выкладкой упаковщика: мера тут одна и она про зрителя - что
# именно уехало наружу, копия, склейка или ничего.
flat = grid_for(source_url, 60.0, on_keys=False)
# Копия идёт с нуля, а заход кодировщика - с ``FIRST``, и это не экономия строк: у
# копии ``-ss`` уводит первый пакет на опорный кадр РАНЬШЕ границы (докатка), и её
# место в ленте считает показ (:func:`pack_start`), а не сетка. Перекодирующий ffmpeg
# встаёт по ``-ss`` точно и докатки не делает - ему граница и есть начало.
run = pack("flat-copy", flat, None, 0, LAST)
spare = pack("flat-recode", flat, recode, FIRST, LAST)
out = root / "out"
out.mkdir()
Packer(proc=_Exited(), out=out, run=run, spare=spare, last=LAST).publish()
PY
    set -- "$seam_dir"/copy/v*.ts -- "$seam_dir"/recode/v*.ts -- "$seam_dir"/out/v*.ts
fi

.venv/bin/python - "$@" <<'PY'
from __future__ import annotations

import json
from pathlib import Path
import subprocess
import sys


def packets(path: Path) -> dict[str, list[float]]:
    probe = subprocess.run(
        [
            "ffprobe",
            "-v",
            "error",
            "-show_packets",
            "-show_streams",
            "-of",
            "json",
            str(path),
        ],
        check=True,
        capture_output=True,
        text=True,
    )
    data = json.loads(probe.stdout)
    kinds = {stream["index"]: stream["codec_type"] for stream in data["streams"]}
    found: dict[str, list[float]] = {"video": [], "audio": []}
    for packet in data["packets"]:
        kind = kinds.get(packet["stream_index"])
        if kind in found and "dts_time" in packet:
            found[kind].append(float(packet["dts_time"]))
    return found


broken = False
groups = [[]]
for name in sys.argv[1:]:
    if name == "--":
        groups.append([])
    else:
        groups[-1].append(Path(name))
# Ход ленты сверяется у кусков ОДНОГО прогона: там оба соседа нарезаны одним муксером
# из одного потока, и «метка назад» на их стыке - это дефект и ничего больше. У
# выложенного наружу соседями встают куски разных производителей (копия и склейка), у
# которых своя задержка переупорядочивания, и общей меры хода ленты на таком стыке нет.
SEAMS = ("упаковка копией", "непрерывность перекода")
for leg, pieces in zip((*SEAMS, "выкладка зрителю"), groups):
    if len(pieces) < 2:
        raise SystemExit("сторожу стыков нужно хотя бы два куска")
    timeline = [packets(piece) for piece in pieces]
    for piece, found in zip(pieces, timeline):
        # 🔴 TC-698. Кусок без единого видеопакета - это не «кусок похуже», а десять
        # секунд звука на чёрном экране. Сверке хода ленты он невидим ПО ПОСТРОЕНИЮ: у
        # такого куска нет ни первой метки, ни последней, сверять нечего, и ветка ниже
        # молча его пропускает. Ровно поэтому он уезжал зрителю при зелёном гейте.
        if not found["video"]:
            print(f"{leg}: {piece.name} - ни одного видеокадра", file=sys.stderr)
            broken = True
    if leg not in SEAMS:
        continue
    for seam, (left, right) in enumerate(zip(timeline, timeline[1:]), start=1):
        for stream, label in (("video", "видео"), ("audio", "звук")):
            if not left[stream] or not right[stream]:
                continue
            rollback = max(left[stream]) - min(right[stream])
            if rollback >= 0:
                print(f"{leg}, стык {seam}: {label}, откат {rollback:.3f} с", file=sys.stderr)
                broken = True
if broken:
    raise SystemExit(1)
PY

.venv/bin/python -m pytest -m 'ffmpeg or machine' -n 0
